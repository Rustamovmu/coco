<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <main class="home-container">
    <div class="home-particles" data-home-particles aria-hidden="true"></div>
    <nav class="navigation-menu" aria-label="Admin navigation">
      <ul class="nav justify-content-center">
        <li class="nav-item"><a class="nav-link active" href="/admin">Home</a></li>
        <% if (!member) { %>
          <li class="nav-item"><a class="nav-link" href="/admin/signup">Signup</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/login">Login</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/admin/product/all">Products</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/order/all">Orders</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/user/all">Users</a></li>
          <li class="nav-item" onclick="return confirm('Do you want to logout?')">
            <a class="nav-link" href="/admin/logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </nav>

    <section class="home-content" aria-labelledby="home-title">
      <div class="home-intro">
        <p class="home-kicker">COCO ADMIN</p>
        <h1 id="home-title">Style your collection with confidence.</h1>
        <p class="home-description">
          Manage your clothing catalog, stock, and customer accounts from one place.
        </p>
        <% if (member) { %>
          <a class="home-cta" href="/admin/product/all">Manage products</a>
        <% } else { %>
          <a class="home-cta" href="/admin/login">Enter admin panel</a>
        <% } %>
      </div>
      <div class="fashion-hero-frame">
        <img
          class="fashion-hero"
          src="/media/images/banners/coco-admin-menswear.jpeg"
          width="736"
          height="1104"
          decoding="async"
          alt="Mannequin wearing a white polo and shorts in a modern menswear store"
        />
      </div>
    </section>
  </main>
  <script src="/js/home.js"></script>
</body>
</html>
